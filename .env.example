# ---- Basics ----
PORT=3000
# Public address once deployed, e.g. https://surplusbuild.in (used for links inside messages)
BASE_URL=
DB_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# The phone number that becomes admin on first login (10 digits).
ADMIN_PHONE=9XXXXXXXXX

# Local development only: every login code becomes this value. Never set in production.
DEV_OTP=123456

# ---- Marketplace rules ----
# Lots worth at least this many rupees get an on-site inspection task.
INSPECT_THRESHOLD=50000
# What an inspector earns per completed inspection (rupees).
INSPECTION_FEE=300
# Pilot revenue model: lots wait for the seller's listing fee before going live.
LISTING_FEE_REQUIRED=false
LISTING_FEE=199
# Your UPI ID; sellers get a "Pay with UPI" button for the listing fee.
UPI_ID=
# How many days an accepted enquiry holds stock for the buyer.
RESERVE_DAYS=3
# Live lots unsold for this many days get a "lower your price" nudge.
PRICE_NUDGE_DAYS=14

# ---- AI photo check (optional) ----
ANTHROPIC_API_KEY=
CHECK_MODEL=claude-sonnet-5-5

# ---- Messaging (optional; without these, messages are only logged in Admin) ----
# Twilio SMS (login codes, and fallback for other messages). India needs DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp Cloud API (preferred for notifications). Use approved templates before launch.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Production ----
# true when served over HTTPS (behind Render, Railway, nginx, etc.)
COOKIE_SECURE=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=300000
